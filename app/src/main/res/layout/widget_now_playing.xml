<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/np_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/np_art"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_cover_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/np_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/widget_now_playing_idle"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/np_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF98989D"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/np_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/np_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/widget_play"
            android:padding="8dp"
            android:src="@drawable/ic_play_arrow"
            android:tint="#FFFA2D48" />

        <ImageView
            android:id="@+id/np_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/widget_next"
            android:padding="8dp"
            android:src="@drawable/ic_skip_next"
            android:tint="#FFFA2D48" />
    </LinearLayout>
</LinearLayout>
