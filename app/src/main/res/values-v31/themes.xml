<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the launch screen is plain black with the icon, then fades into Home (MainActivity). -->
    <style name="Theme.NovaFork" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nova_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/nova_black</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/nova_black</item>
    </style>

    <style name="Theme.NovaFork.Player" parent="Theme.NovaFork">
        <item name="android:windowBackground">@color/nova_black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
