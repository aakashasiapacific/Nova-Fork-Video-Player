<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; the window theme only sets the first frame and system bars. -->
    <style name="Theme.NovaFork" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nova_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.NovaFork.Player" parent="Theme.NovaFork">
        <item name="android:windowBackground">@color/nova_black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
